{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "1.3.1",
  "author": "DEV + DESIGN = REAILISM",
  "minimum_chrome_version": "120",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "html/popup.html",
    "default_title": "__MSG_name__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "userscript.user.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "js/hover-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "js/media-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "js/media-relay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "find-all": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "XXL Find All HiRes"
    }
  },
  "options_ui": {
    "page": "html/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "webRequest",
    "contextMenus",
    "downloads",
    "cookies",
    "declarativeNetRequest"
  ],
  "optional_permissions": [
    "history",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
